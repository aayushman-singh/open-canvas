{
  "styleKit": "charcoal",
  "pages": [
    {
      "id": "page-home",
      "slug": "home",
      "title": "Home",
      "width": 1440,
      "sections": [
        {
          "id": "section-hero",
          "recipeId": "hero-split",
          "name": "Hero",
          "height": 760,
          "backgroundEffect": "grain",
          "entrance": "fade-up",
          "elements": [
            {
              "id": "hero-heading",
              "type": "text",
              "box": { "x": 80, "y": 120, "w": 600, "h": 180, "z": 3 },
              "content": [
                { "text": "Ship a site that feels " },
                { "text": "lived-in", "marks": [{ "type": "bold" }] },
                { "text": "." }
              ],
              "role": "heading",
              "fontSize": 64,
              "fontWeight": 700,
              "align": "left",
              "motion": { "preset": "fade-up", "delayMs": 50 }
            },
            {
              "id": "hero-body",
              "type": "text",
              "box": { "x": 80, "y": 320, "w": 540, "h": 120, "z": 3 },
              "content": [
                { "text": "Position elements freely. Pick a style kit. " },
                {
                  "text": "Publish to rev01.aayushman.dev",
                  "marks": [{ "type": "link", "href": "https://rev01.aayushman.dev" }]
                },
                { "text": "." }
              ],
              "role": "body",
              "fontSize": 20,
              "fontWeight": 400,
              "align": "left"
            },
            {
              "id": "hero-action",
              "type": "action",
              "box": { "x": 80, "y": 480, "w": 200, "h": 56, "z": 3 },
              "label": "Start editing",
              "href": "/edit",
              "variant": "solid"
            },
            {
              "id": "hero-media",
              "type": "media",
              "box": { "x": 760, "y": 80, "w": 600, "h": 600, "z": 2 },
              "mediaKind": "image",
              "assetId": "seed-hero-poster-1",
              "alt": "Editable site loop",
              "fit": "cover"
            },
            {
              "id": "hero-orb",
              "type": "shape",
              "box": { "x": 700, "y": 40, "w": 120, "h": 120, "z": 4, "rotation": 12 },
              "variant": "circle"
            },
            {
              "id": "hero-card",
              "type": "container",
              "box": { "x": 60, "y": 100, "w": 640, "h": 460, "z": 1 },
              "variant": "soft-panel"
            }
          ]
        },
        {
          "id": "section-features",
          "recipeId": "feature-grid",
          "name": "Features",
          "height": 720,
          "backgroundEffect": "paper",
          "entrance": "stagger-children",
          "elements": [
            {
              "id": "features-heading",
              "type": "text",
              "box": { "x": 80, "y": 80, "w": 800, "h": 90, "z": 2 },
              "content": [
                { "text": "Everything an Owner needs, " },
                { "text": "nothing they do not", "marks": [{ "type": "italic" }] },
                { "text": "." }
              ],
              "role": "heading",
              "fontSize": 44,
              "fontWeight": 600,
              "align": "left"
            },
            {
              "id": "feature-1-image",
              "type": "media",
              "box": { "x": 80, "y": 220, "w": 380, "h": 280, "z": 2 },
              "mediaKind": "image",
              "assetId": "seed-feature-canvas-1",
              "alt": "Canvas editing surface",
              "fit": "cover"
            },
            {
              "id": "feature-1-label",
              "type": "text",
              "box": { "x": 80, "y": 520, "w": 380, "h": 60, "z": 2 },
              "content": [{ "text": "Position freely" }],
              "role": "label",
              "fontSize": 16,
              "fontWeight": 500,
              "align": "left"
            },
            {
              "id": "feature-2-frame",
              "type": "container",
              "box": { "x": 520, "y": 220, "w": 380, "h": 360, "z": 1 },
              "variant": "editorial-frame"
            },
            {
              "id": "feature-3-shape",
              "type": "shape",
              "box": { "x": 960, "y": 240, "w": 360, "h": 320, "z": 2 },
              "variant": "blob"
            }
          ]
        },
        {
          "id": "section-cta",
          "recipeId": "cta-band",
          "name": "Call to action",
          "height": 620,
          "backgroundEffect": "soft-light",
          "entrance": "scale-in",
          "elements": [
            {
              "id": "cta-heading",
              "type": "text",
              "box": { "x": 220, "y": 160, "w": 1000, "h": 160, "z": 2 },
              "content": [{ "text": "Publish when it feels right." }],
              "role": "heading",
              "fontSize": 56,
              "fontWeight": 700,
              "align": "center"
            },
            {
              "id": "cta-primary",
              "type": "action",
              "box": { "x": 540, "y": 360, "w": 220, "h": 64, "z": 3 },
              "label": "Open the editor",
              "href": "https://rev01.example.com/edit",
              "variant": "pill"
            },
            {
              "id": "cta-secondary",
              "type": "action",
              "box": { "x": 780, "y": 360, "w": 220, "h": 64, "z": 3 },
              "label": "Email us",
              "href": "mailto:hello@rev01.example.com",
              "variant": "underline"
            }
          ]
        }
      ]
    }
  ]
}
