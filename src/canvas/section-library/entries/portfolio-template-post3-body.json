          "w": 720,
          "h": 156,
          "z": 3
        },
        "content": [
          {
            "text": "Turn off your wifi. Open the app. Does it load? Can you make a change? Does the change persist after a restart? If three answers are yes, you have software. If one is no, you have a marketing claim wrapped around someone else's database."
          }
        ],
        "role": "body",
        "fontSize": 17,
        "fontWeight": 400,
