        {
          "type": "paragraph",
          "attrs": { "align": "center" },
          "content": [
            { "type": "text", "text": "An independent " },
            { "type": "text", "text": "type foundry", "marks": [{ "type": "bold" }] },
            { "type": "text", "text": " building " },
            {
              "type": "text",
              "text": "OpenType",
              "marks": [{ "type": "code" }]
